<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>

<body>

    <nav class="navbar navbar-dark bg-primary">
        <div class="container-fluid">

            <span class="navbar-brand">
                Succeed Services
            </span>

        </div>
    </nav>

    <div class="container-fluid">

        <div class="row">

            <div class="col-md-2 bg-light vh-100">

                <ul class="nav flex-column mt-3">

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/WhatsApp/Dashboard">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/WhatsApp">
                            Send Message
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/WhatsApp/Logs">
                            Message Logs
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="#">
                            Templates
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/Settings">
                            Settings
                        </a>
                    </li>

                </ul>

            </div>

            <div class="col-md-10 mt-3">

                @RenderBody()

            </div>

        </div>

    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>