@model SucceedServices.WhatsApp.Models.WhatsAppSettingViewModel

@{
    ViewData["Title"] = "Settings";
}

<div class="card shadow">

    <div class="card-header">
        <h3>WhatsApp Settings</h3>
    </div>

    <div class="card-body">

        <div class="mb-3">

            <label class="form-label">
                Access Token
            </label>

            <input asp-for="AccessToken"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Phone Number ID
            </label>

            <input asp-for="PhoneNumberId"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Business Account ID
            </label>

            <input asp-for="BusinessAccountId"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Verify Token
            </label>

            <input asp-for="VerifyToken"
                   class="form-control" />

        </div>

        <button class="btn btn-primary">
            Save Settings
        </button>

    </div>

</div>